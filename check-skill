#!/usr/bin/env python3
"""Validate skills in this repo: frontmatter, reference links, fences, description length."""
import os
import re
import sys

ROOT = os.path.dirname(os.path.abspath(__file__))
HERMES_DESC_TRUNCATE = 57
REQUIRED_KEYS = ("name", "description")


def load_frontmatter(text, errors, skill):
    if not text.startswith("---\n"):
        errors.append(f"{skill}: SKILL.md must start with YAML frontmatter")
        return {}
    end = text.find("\n---\n", 3)
    if end == -1:
        errors.append(f"{skill}: unterminated frontmatter")
        return {}
    block = text[4:end]
    try:
        import yaml  # optional
    except ImportError:
        yaml = None
    if yaml is not None:
        try:
            return yaml.safe_load(block) or {}
        except Exception as exc:  # invalid YAML is a hard error, not a crash
            first = str(exc).splitlines()[0]
            errors.append(f"{skill}: frontmatter is not valid YAML ({first})")
            return {}
    data = {}
    for line in block.splitlines():
        m = re.match(r"^([a-z_]+):\s*(.*)$", line)
        if m:
            data[m.group(1)] = m.group(2)
    return data


def check_skill(skill, errors, warnings):
    d = os.path.join(ROOT, skill)
    path = os.path.join(d, "SKILL.md")
    text = open(path, encoding="utf-8").read()
    fm = load_frontmatter(text, errors, skill)

    for key in REQUIRED_KEYS:
        if not fm.get(key):
            errors.append(f"{skill}: frontmatter missing '{key}'")

    if fm.get("name") and fm["name"] != skill:
        errors.append(f"{skill}: frontmatter name '{fm['name']}' != directory name")

    desc = str(fm.get("description", ""))
    head = desc[:HERMES_DESC_TRUNCATE].lower()
    if desc and head.startswith("this skill should be used"):
        warnings.append(
            f"{skill}: description wastes the {HERMES_DESC_TRUNCATE}-char Hermes index window "
            f"on boilerplate: {desc[:HERMES_DESC_TRUNCATE]!r}"
        )

    # frontmatter completeness - Hermes uses these for category placement + index
    for key, why in (
        ("version", "no version — bumps are invisible to consumers"),
        ("license", "no license"),
        ("platforms", "no platforms list"),
    ):
        if not fm.get(key):
            warnings.append(f"{skill}: {why}")
    meta = fm.get("metadata") or {}
    hermes = meta.get("hermes") if isinstance(meta, dict) else None
    if not (isinstance(hermes, dict) and hermes.get("category")):
        warnings.append(
            f"{skill}: no metadata.hermes.category — install-skill --target hermes will "
            f"drop it in general/"
        )

    # path-claim lint: a skill naming a local path that doesn't exist sends agents to a
    # dead directory (these repos aren't cloned on every machine). Mentions that are
    # already written defensively (guarded with 2>/dev/null, or globbed) are skipped.
    home = os.path.expanduser("~")
    claim_re = re.compile(r"~/(?:Projects|\.config|\.local)/[\w.@-]+")
    for dirpath, _dirs, files in os.walk(d):
        for name in sorted(files):
            if not name.endswith(".md"):
                continue
            p = os.path.join(dirpath, name)
            rel = os.path.relpath(p, d)
            for lineno, line in enumerate(open(p, encoding="utf-8"), 1):
                if "2>/dev/null" in line:
                    continue
                for m in claim_re.finditer(line):
                    if line[m.end():m.end() + 1] == "*":
                        continue
                    claim = m.group(0)
                    if not os.path.exists(os.path.join(home, claim[2:])):
                        warnings.append(
                            f"{skill}: {rel}:{lineno} references {claim} which does not exist here"
                        )

    # references linked from SKILL.md must exist. Deliberately just
    # references/templates, not scripts/ - a skill's prose can legitimately
    # mention a scripts/foo.mjs path that lives in the *target* project it's
    # documenting (see astro-content-seo), not a file the skill itself ships.
    linked = set(re.findall(r"(?:references|templates)/[\w.-]+\.\w+", text))
    for rel in sorted(linked):
        if not os.path.isfile(os.path.join(d, rel)):
            errors.append(f"{skill}: SKILL.md links missing file {rel}")

    # every reference file should be linked from SKILL.md
    for sub in ("references", "templates"):
        subdir = os.path.join(d, sub)
        if not os.path.isdir(subdir):
            continue
        for name in sorted(os.listdir(subdir)):
            rel = f"{sub}/{name}"
            if rel not in linked:
                warnings.append(f"{skill}: {rel} exists but is never referenced from SKILL.md")

    # balanced code fences in every markdown file
    for dirpath, _dirs, files in os.walk(d):
        for name in files:
            if not name.endswith(".md"):
                continue
            p = os.path.join(dirpath, name)
            body = open(p, encoding="utf-8").read()
            fences = len(re.findall(r"^\s*```", body, re.M)) + len(re.findall(r"^\s*````", body, re.M))
            if fences % 2:
                errors.append(f"{skill}: unbalanced code fence in {os.path.relpath(p, d)}")


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    strict = "--strict" in sys.argv
    skills = sorted(
        n for n in os.listdir(ROOT)
        if os.path.isfile(os.path.join(ROOT, n, "SKILL.md"))
    )
    targets = args or skills
    errors, warnings = [], []
    for skill in targets:
        if skill not in skills:
            errors.append(f"{skill}: no such skill directory with SKILL.md")
            continue
        check_skill(skill, errors, warnings)

    for w in warnings:
        print(f"warn:  {w}")
    for e in errors:
        print(f"ERROR: {e}")
    print(f"\n{len(targets)} skill(s) checked — {len(errors)} error(s), {len(warnings)} warning(s)")
    if strict and warnings and not errors:
        print("--strict: failing on warnings")
    return 1 if errors or (strict and warnings) else 0


if __name__ == "__main__":
    sys.exit(main())
